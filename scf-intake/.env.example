# ── Agentic Intake Request Application — environment example ──────────────────
# Copy to `.env` and fill in as needed. EVERYTHING here is OPTIONAL: with no
# values set, the backend agents run a transparent, deterministic engine and the
# frontend runs fully client-side. Secrets only unlock the production paths.

# ── LLM adapter (optional) ────────────────────────────────────────────────────
# Set an OpenAI key to enable the LLM-backed validation/justification path that
# sits behind the swappable adapter (app/tools/llm.py). Leave blank to stay
# fully offline/deterministic.
OPENAI_API_KEY=
SCF_VALIDATION_MODEL=gpt-4o-mini
SCF_REASONING_MODEL=gpt-4o

# ── Persistence ───────────────────────────────────────────────────────────────
# SQLite by default; point at Postgres for production (Postgres-compatible schema).
SCF_INTAKE_DB_URL=sqlite:///./data/scf_intake.db

# ── Jira integration (optional) ───────────────────────────────────────────────
# Without an MCP URL the Documentation agent uses a deterministic stub writer.
SCF_JIRA_PROJECT=SCF
SCF_JIRA_MCP_URL=

# ── Agent behavior ────────────────────────────────────────────────────────────
# Max consecutive *unproductive* clarification rounds before escalating to human.
SCF_MAX_ROUNDS=8

# ── Frontend ──────────────────────────────────────────────────────────────────
# Vite base path. Use "/SCFMarvel/" for GitHub Pages, "/" for local/other hosts.
VITE_BASE=/
# Optional: point the SPA at the FastAPI backend instead of the client engine.
VITE_API_BASE=
